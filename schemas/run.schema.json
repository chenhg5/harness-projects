{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhg5/harness-projects/schemas/run.schema.json",
  "title": "Harness Project Run",
  "type": "object",
  "required": ["schemaVersion", "id", "taskId", "adapter", "status", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "taskId": { "type": "string" },
    "adapter": { "type": "string", "minLength": 1 },
    "harness": { "type": "string" },
    "agentId": { "type": "string" },
    "objective": { "type": "string" },
    "status": { "enum": ["planned", "running", "succeeded", "failed", "paused", "cancelled"] },
    "worktree": { "type": "string" },
    "command": { "type": "string" },
    "commit": { "type": "string" },
    "changedFiles": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "array", "items": { "type": "string" } },
    "logs": { "type": "array", "items": { "type": "string" } },
    "approval": { "type": "string" },
    "exitCode": { "type": "integer" },
    "error": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
