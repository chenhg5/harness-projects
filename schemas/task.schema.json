{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhg5/harness-projects/schemas/task.schema.json",
  "title": "Harness Project Task",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "status", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "goalId": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "deliverables": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "priority": { "enum": ["critical", "high", "medium", "low"] },
    "owner": { "type": "string" },
    "dueDate": { "type": "string" },
    "estimateHours": { "type": "number", "exclusiveMinimum": 0 },
    "status": { "enum": ["pending", "ready", "in_progress", "blocked", "completed", "failed", "cancelled"] },
    "dependsOn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "agentId": { "type": "string" },
    "blockedReason": { "type": "string" },
    "result": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
