{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenhg5/harness-projects/schemas/goal.schema.json",
  "title": "Harness Project Goal",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "status", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "outcome": { "type": "string" },
    "owner": { "type": "string" },
    "targetDate": { "type": "string" },
    "reviewCadence": { "type": "string" },
    "status": { "enum": ["draft", "active", "completed", "archived"] },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "keyResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "metric", "direction", "target", "status"],
        "properties": {
          "id": { "type": "string" },
          "metric": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "unit": { "type": "string" },
          "direction": { "enum": ["increase", "decrease", "maintain", "boolean"] },
          "baseline": { "type": "number" },
          "target": { "type": "number" },
          "current": { "type": "number" },
          "status": { "enum": ["planned", "in_progress", "achieved", "at_risk", "missed"] },
          "dueDate": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["active", "completed"]}}},
      "then": {"required": ["description", "outcome", "keyResults"]}
    },
    {
      "if": {"properties": {"status": {"const": "completed"}}},
      "then": {"required": ["evidence"]}
    }
  ],
  "additionalProperties": true
}
